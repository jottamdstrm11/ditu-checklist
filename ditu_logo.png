<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Checklist DITU</title>
<style>
:root{
  --bg:#0f1117;--surface:#1a1d27;--surface2:#22263a;--border:#2e3350;
  --text:#e8eaf0;--dim:#7c82a0;
  --pass:#1a4731;--pass-t:#4ade80;
  --fail:#4a1a1a;--fail-t:#f87171;
  --na:#2a2d3e;--na-t:#7c82a0;
  --utt:#3d3010;--utt-t:#fbbf24;
  --accent:#6366f1;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:system-ui,sans-serif;font-size:13px}

.screen{display:none}
#screenSetup.active,#screenSuccess.active{display:block;height:100%;overflow-y:auto}
#screenChecklist.active{display:flex;flex-direction:column;height:100%;overflow:hidden}

/* SETUP */
.setup-wrap{max-width:480px;margin:0 auto;padding:40px 20px}
.logo{text-align:center;margin-bottom:32px}
.logo-banner{margin-bottom:8px}
.logo-svg{width:260px;height:auto;display:block;margin:0 auto}
.logo h1{font-size:20px;font-weight:800}
.logo h1 span{color:var(--accent)}
.logo .sub{font-size:12px;color:var(--dim);margin-top:4px}
.card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px;margin-bottom:16px}
.card label{display:block;font-size:11px;color:var(--dim);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;font-weight:600}
.card select{width:100%;padding:10px 12px;border-radius:8px;border:1px solid var(--border);background:var(--surface2);color:var(--text);font-size:14px;outline:none}
.card select:focus{border-color:var(--accent)}
.type-toggle{display:flex;gap:8px}
.type-btn{flex:1;padding:10px;border-radius:8px;border:1px solid var(--border);background:var(--surface2);color:var(--dim);cursor:pointer;font-size:13px;font-weight:600;text-align:center;transition:all .15s}
.type-btn.active{background:var(--accent);border-color:var(--accent);color:#fff}
.franja-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.franja-btn{padding:8px 4px;border-radius:6px;border:1px solid var(--border);background:var(--surface2);color:var(--dim);cursor:pointer;font-size:12px;text-align:center;transition:all .15s}
.franja-btn.active{background:var(--accent);border-color:var(--accent);color:#fff}
.start-btn{width:100%;padding:14px;border-radius:10px;border:none;background:var(--accent);color:#fff;font-size:15px;font-weight:700;cursor:pointer;margin-top:8px}
.start-btn:disabled{opacity:.4;cursor:not-allowed}

/* CHECKLIST LAYOUT */
.cl-header{
  flex:0 0 auto;
  background:var(--surface);border-bottom:1px solid var(--border);
  padding:0 16px;height:56px;
  display:flex;align-items:center;justify-content:space-between;
}
.cl-header .op{font-weight:700;font-size:14px}
.cl-header .meta{font-size:11px;color:var(--dim)}
.progress-bar{flex:0 0 3px;background:var(--border)}
.progress-fill{height:100%;background:var(--accent);transition:width .3s}
.table-container{flex:1 1 0;overflow:auto;min-height:0}
.cl-bottom{flex:0 0 auto;background:var(--surface);border-top:2px solid var(--accent);padding:10px 16px}
.send-btn{width:100%;padding:13px;border-radius:8px;border:none;background:var(--accent);color:#fff;font-size:14px;font-weight:700;cursor:pointer}
.send-btn:disabled{opacity:.4;cursor:not-allowed}

/* =============================================
   TABLE — border-separate para que sticky funcione en Chrome
   ============================================= */
table{
  border-collapse:separate;
  border-spacing:0;
  width:100%;
  min-width:860px;
}

/* THEAD sticky — aplicado al <thead> (no al <th>) */
thead{
  position:sticky;
  top:0;
  z-index:20;
}
thead th{
  background:var(--surface2);
  color:var(--dim);font-size:9px;font-weight:700;
  text-transform:uppercase;letter-spacing:.04em;
  padding:8px 4px;
  white-space:nowrap;text-align:center;
  /* borders */
  border-bottom:2px solid var(--border);
  border-right:1px solid var(--border);
}
thead th:last-child{border-right:none}

/* Columnas izquierda sticky en thead */
thead th.th-num{
  width:38px;min-width:38px;
  position:sticky;left:0;z-index:5;
  background:var(--surface2);
}
thead th.th-item{
  width:210px;min-width:180px;
  text-align:left;padding-left:10px;
  position:sticky;left:38px;z-index:5;
  background:var(--surface2);
  border-right:2px solid var(--border);
}

/* SECTION ROWS */
tr.sec-row td{
  background:var(--accent);color:#fff;
  font-weight:800;font-size:11px;
  text-transform:uppercase;letter-spacing:.08em;
  padding:8px 14px;
  border-top:3px solid var(--bg);
  border-bottom:1px solid rgba(255,255,255,.2);
}
.sec-actions{float:right}
.sec-pass-btn{
  background:rgba(255,255,255,.2);color:#fff;
  border:1px solid rgba(255,255,255,.3);
  padding:2px 10px;border-radius:4px;font-size:10px;cursor:pointer;font-weight:700;
}
.sec-pass-btn:hover{background:rgba(255,255,255,.35)}

/* ITEM ROWS */
tr.item-row td{
  border-bottom:1px solid var(--border);
  border-right:1px solid var(--border);
  padding:0;height:34px;vertical-align:middle;
}
tr.item-row td:last-child{border-right:none}
tr.item-row:nth-child(even) td{background:rgba(255,255,255,.025)}

/* STICKY BODY CELLS — solo horizontal */
td.td-num{
  text-align:center;color:var(--dim);font-size:11px;font-weight:600;padding:4px;
  position:sticky;left:0;z-index:5;
  background:var(--bg);
  border-right:1px solid var(--border);
}
tr.item-row:nth-child(even) td.td-num{background:#12151e}

td.td-item{
  padding:6px 10px;font-size:12px;line-height:1.35;
  position:sticky;left:38px;z-index:5;
  background:var(--bg);
  border-right:2px solid var(--border);
}
tr.item-row:nth-child(even) td.td-item{background:#12151e}

/* STATUS BUTTON */
.s-btn{
  display:block;width:100%;height:34px;
  padding:4px 2px;text-align:center;
  font-size:10px;font-weight:700;cursor:pointer;
  border:none;background:transparent;color:var(--border);
  letter-spacing:.02em;transition:background .1s,color .1s;
}
.s-btn:hover{background:rgba(255,255,255,.06);color:var(--dim)}
.s-btn.PASS{background:var(--pass);color:var(--pass-t)}
.s-btn.FAIL{background:var(--fail);color:var(--fail-t)}
.s-btn.NA{background:var(--na);color:var(--na-t)}
.s-btn.UTT{background:var(--utt);color:var(--utt-t);font-size:8px}

/* SUCCESS */
.success-wrap{max-width:400px;margin:0 auto;padding:60px 20px;text-align:center}
.success-icon{font-size:56px;margin-bottom:20px}
.success-wrap h2{font-size:22px;font-weight:800;margin-bottom:8px}
.success-wrap p{color:var(--dim);margin-bottom:24px}
.btn-row{display:flex;gap:10px;justify-content:center}
.btn-row button{padding:10px 20px;border-radius:8px;border:1px solid var(--border);background:var(--surface);color:var(--text);cursor:pointer;font-size:13px}
.btn-row a{padding:10px 20px;border-radius:8px;border:none;background:var(--accent);color:#fff;font-size:13px;font-weight:700;text-decoration:none}

.spinner{display:inline-block;width:20px;height:20px;border:2px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.msg{text-align:center;padding:48px;color:var(--dim)}
</style>
</head>
<body>

<div class="screen active" id="screenSetup">
<div class="setup-wrap">
  <div class="logo">
    <div class="logo-banner">
      <img src="data:image/png;base64," alt="ditu" class="logo-svg">    </div>
    <div class="sub">Monitoreo & Soporte — App Caracol TV</div>
  </div>
  <div class="card">
    <label>Tu nombre</label>
    <select id="selOperador">
      <option value="">— Selecciona —</option>
      <option>Jhoinner Samboni</option><option>Cristopher Piamba</option>
      <option>Santiago Urrego</option><option>Jeison Sandoval</option>
      <option>Edwin Pabon</option><option>Gabriel Gaitan</option>
      <option>Stiven Arboleda</option><option>Arturo Romero</option>
      <option>Maykol Riveros</option><option>Sara Moreno</option>
    </select>
  </div>
  <div class="card">
    <label>Tipo de checklist</label>
    <div class="type-toggle">
      <div class="type-btn active" data-type="soporte" onclick="selectType('soporte')">🟣 Soporte</div>
      <div class="type-btn" data-type="monitoreo" onclick="selectType('monitoreo')">🔵 Monitoreo</div>
    </div>
  </div>
  <div class="card">
    <label>Franja horaria</label>
    <div class="franja-grid" id="franjaGrid"></div>
  </div>
  <button class="start-btn" id="btnStart" onclick="startChecklist()" disabled>Comenzar checklist →</button>
</div>
</div>

<div class="screen" id="screenChecklist">
  <div class="cl-header">
    <div>
      <div class="op" id="headerOp">—</div>
      <div class="meta" id="headerMeta">—</div>
    </div>
    <div style="font-size:12px;color:var(--dim)" id="headerPct">—</div>
  </div>
  <div class="progress-bar"><div class="progress-fill" id="progressFill" style="width:0%"></div></div>
  <div class="table-container" id="tableContainer">
    <div class="msg"><div class="spinner"></div></div>
  </div>
  <div class="cl-bottom">
    <button class="send-btn" id="sendBtn" onclick="enviarChecklist()">✅ Enviar Checklist</button>
  </div>
</div>

<div class="screen" id="screenSuccess">
<div class="success-wrap">
  <div class="success-icon">✅</div>
  <h2>¡Checklist enviado!</h2>
  <p id="successMsg"></p>
  <div class="btn-row">
    <button onclick="resetForm()">Nuevo checklist</button>
    <a href="dashboard_supabase.html" target="_blank">Ver Dashboard ↗</a>
  </div>
</div>
</div>

<script>
const SUPA_URL='https://akpuifenfstvobwtqtcq.supabase.co';
const SUPA_KEY='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFrcHVpZmVuZnN0dm9id3RxdGNxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY4MDMxOTAsImV4cCI6MjEwMjM3OTE5MH0.5397pVE5XlyV2864iTf96Ttj--HqoffovzJ9Z9mI0ig';
const FRANJAS=['01:00','04:00','07:00','10:00','13:00','16:00','19:00','22:00'];
let selectedType='soporte',selectedFranja='',DEVICES=[],ITEMS={},results={};

async function supa(p){const r=await fetch(SUPA_URL+p,{headers:{'apikey':SUPA_KEY,'Authorization':'Bearer '+SUPA_KEY}});return r.json();}

async function loadConfig(){
  const [devs,items]=await Promise.all([
    supa('/rest/v1/checklist_devices?activo=eq.true&order=orden&select=*'),
    supa('/rest/v1/checklist_items?activo=eq.true&order=orden&select=*')
  ]);
  DEVICES=devs;
  ITEMS={soporte:[],monitoreo:[]};
  ['soporte','monitoreo'].forEach(tipo=>{
    const ti=items.filter(i=>i.tipo===tipo);
    const secs=[...new Set(ti.map(i=>i.seccion))];
    ITEMS[tipo]=secs.map(s=>({s,items:ti.filter(i=>i.seccion===s).map(i=>({n:i.numero_item,t:i.nombre_item}))}));
  });
}
function initFranjas(){
  const now=new Date(),mins=now.getHours()*60+now.getMinutes();
  let auto='10:00';
  if(mins<180)auto='01:00';else if(mins<360)auto='04:00';else if(mins<540)auto='07:00';
  else if(mins<720)auto='10:00';else if(mins<900)auto='13:00';else if(mins<1080)auto='16:00';
  else if(mins<1260)auto='19:00';else auto='22:00';
  selectedFranja=auto;
  document.getElementById('franjaGrid').innerHTML=FRANJAS.map(f=>
    `<div class="franja-btn${f===auto?' active':''}" onclick="selectFranja('${f}')">${f}</div>`
  ).join('');
}
function selectType(t){selectedType=t;document.querySelectorAll('.type-btn').forEach(b=>b.classList.toggle('active',b.dataset.type===t));checkReady();}
function selectFranja(f){selectedFranja=f;document.querySelectorAll('.franja-btn').forEach(b=>b.classList.toggle('active',b.textContent===f));checkReady();}
function checkReady(){document.getElementById('btnStart').disabled=!document.getElementById('selOperador').value||!selectedFranja||!DEVICES.length;}
document.getElementById('selOperador').addEventListener('change',checkReady);

function startChecklist(){
  const op=document.getElementById('selOperador').value;
  document.getElementById('headerOp').textContent=op;
  document.getElementById('headerMeta').textContent=
    (selectedType==='soporte'?'🟣 Soporte':'🔵 Monitoreo')+' · Franja '+selectedFranja+' · '+
    new Date().toLocaleDateString('es-CO',{day:'2-digit',month:'short'});
  results={};buildTable();show('screenChecklist');updateProgress();
}

function buildTable(){
  const data=ITEMS[selectedType]||[];
  const totalCols=2+DEVICES.length;
  const devH=DEVICES.map(d=>
    `<th>${d.nombre}<br><span style="font-size:8px;font-weight:400;color:var(--dim)">${d.version}</span></th>`
  ).join('');
  let html=`<table><thead><tr>
    <th class="th-num">#</th><th class="th-item">Item de verificación</th>${devH}
  </tr></thead><tbody>`;
  data.forEach((sec,si)=>{
    html+=`<tr class="sec-row"><td colspan="${totalCols}">📋 ${sec.s}
      <span class="sec-actions"><button class="sec-pass-btn" onclick="passAll(${si})">✓ Todo PASS</button></span>
    </td></tr>`;
    sec.items.forEach((item,ii)=>{
      const devCells=DEVICES.map(d=>{
        const k=`${si}_${ii}_${d.clave}`,st=results[k]||'';
        const lbl=st==='NA'?'N/A':st==='UTT'?'UTT':st||'—';
        return`<td><button class="s-btn${st?' '+st:''}" onclick="cycleStatus(${si},${ii},'${d.clave}',this)">${lbl}</button></td>`;
      }).join('');
      html+=`<tr class="item-row"><td class="td-num">${item.n}</td><td class="td-item">${item.t}</td>${devCells}</tr>`;
    });
  });
  html+='</tbody></table>';
  document.getElementById('tableContainer').innerHTML=html;
}

const CYCLE=['','PASS','FAIL','NA','UTT'];
function cycleStatus(si,ii,devKey,btn){
  const k=`${si}_${ii}_${devKey}`,cur=results[k]||'';
  const next=CYCLE[(CYCLE.indexOf(cur)+1)%CYCLE.length];
  results[k]=next;
  btn.className='s-btn'+(next?' '+next:'');
  btn.textContent=next==='NA'?'N/A':next==='UTT'?'UTT':next||'—';
  updateProgress();
}
function passAll(si){
  const sec=(ITEMS[selectedType]||[])[si];if(!sec)return;
  sec.items.forEach((_,ii)=>DEVICES.forEach(d=>{results[`${si}_${ii}_${d.clave}`]='PASS';}));
  buildTable();updateProgress();
}
function updateProgress(){
  const data=ITEMS[selectedType]||[];
  const total=data.reduce((a,s)=>a+s.items.length*DEVICES.length,0);
  const filled=Object.values(results).filter(v=>v).length;
  const pct=total>0?Math.round(filled/total*100):0;
  document.getElementById('progressFill').style.width=pct+'%';
  document.getElementById('headerPct').textContent=filled+'/'+total+' · '+pct+'%';
}
async function enviarChecklist(){
  const op=document.getElementById('selOperador').value;
  const btn=document.getElementById('sendBtn');
  btn.disabled=true;btn.innerHTML='<span class="spinner"></span> Enviando...';
  try{
    const h={'apikey':SUPA_KEY,'Authorization':'Bearer '+SUPA_KEY,'Content-Type':'application/json','Prefer':'return=representation'};
    const r1=await fetch(SUPA_URL+'/rest/v1/checklist_runs',{method:'POST',headers:h,body:JSON.stringify({
      fecha:new Date().toISOString().split('T')[0],operador:op,tipo:selectedType,hora_franja:selectedFranja
    })});
    const [run]=await r1.json();
    if(!run?.id)throw new Error('No se creó el run');
    const data=ITEMS[selectedType]||[];const rows=[];
    data.forEach((sec,si)=>sec.items.forEach((item,ii)=>DEVICES.forEach(d=>{
      const estado=results[`${si}_${ii}_${d.clave}`];
      if(estado)rows.push({run_id:run.id,seccion:sec.s,numero_item:item.n,nombre_item:item.t,
        dispositivo:d.nombre,estado:estado==='NA'?'N/A':estado==='UTT'?'UNABLE TO TEST':estado});
    })));
    if(rows.length){const r2=await fetch(SUPA_URL+'/rest/v1/checklist_results',{method:'POST',headers:h,body:JSON.stringify(rows)});if(!r2.ok)throw new Error('Error guardando resultados');}
    const total=rows.length,pass=rows.filter(r=>r.estado==='PASS').length;
    document.getElementById('successMsg').textContent=`${total} verificaciones · ${pass} PASS (${total>0?Math.round(pass/total*100):0}%) · ${op}`;
    show('screenSuccess');
  }catch(e){alert('Error: '+e.message);btn.disabled=false;btn.textContent='✅ Enviar Checklist';}
}
function resetForm(){results={};document.getElementById('selOperador').value='';checkReady();show('screenSetup');}
function show(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');}
(async()=>{initFranjas();await loadConfig();checkReady();})();
</script>
</body>
</html>
